{
  "manifest_version": 3,
  "name": "ZHunter PRO",
  "version": "11.1.3",
  "description": "Product research side panel: hunt product images, videos and details from Amazon, Walmart, Sam's Club, Alibaba, AliExpress and more; bulk-hunt open tabs or a background queue; export XLSX/CSV/HTML/PDF sheets and image ZIPs.",
  "author": "ZHunter",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "alarms",
    "downloads",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "ZHunter PRO",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open ZHunter PRO"
    },
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://amazon.ca/*",
        "*://*.amazon.de/*",
        "*://amazon.de/*",
        "*://*.amazon.fr/*",
        "*://amazon.fr/*",
        "*://*.amazon.it/*",
        "*://amazon.it/*",
        "*://*.amazon.es/*",
        "*://amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://amazon.co.jp/*",
        "*://*.amazon.in/*",
        "*://amazon.in/*",
        "*://*.amazon.com.au/*",
        "*://amazon.com.au/*",
        "*://*.amazon.com.mx/*",
        "*://amazon.com.mx/*",
        "*://*.amazon.nl/*",
        "*://amazon.nl/*",
        "*://*.amazon.pl/*",
        "*://amazon.pl/*",
        "*://*.amazon.se/*",
        "*://amazon.se/*",
        "*://*.amazon.sg/*",
        "*://amazon.sg/*",
        "*://*.amazon.ae/*",
        "*://amazon.ae/*",
        "*://*.amazon.sa/*",
        "*://amazon.sa/*",
        "*://*.amazon.tr/*",
        "*://amazon.tr/*",
        "*://*.amazon.eg/*",
        "*://amazon.eg/*",
        "*://*.amazon.be/*",
        "*://amazon.be/*",
        "*://*.walmart.com/*",
        "*://walmart.com/*",
        "*://*.samsclub.com/*",
        "*://samsclub.com/*",
        "*://*.faire.com/*",
        "*://faire.com/*",
        "*://*.alibaba.com/*",
        "*://alibaba.com/*",
        "*://*.aliexpress.com/*",
        "*://aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://aliexpress.us/*",
        "*://*.aliexpress.ru/*",
        "*://aliexpress.ru/*",
        "*://*.temu.com/*",
        "*://temu.com/*",
        "*://*.ebay.com/*",
        "*://ebay.com/*",
        "*://*.ebay.co.uk/*",
        "*://ebay.co.uk/*",
        "*://*.ebay.de/*",
        "*://ebay.de/*",
        "*://*.ebay.ca/*",
        "*://ebay.ca/*",
        "*://*.ebay.com.au/*",
        "*://ebay.com.au/*",
        "*://*.ebay.fr/*",
        "*://ebay.fr/*",
        "*://*.ebay.it/*",
        "*://ebay.it/*",
        "*://*.ebay.es/*",
        "*://ebay.es/*",
        "*://*.etsy.com/*",
        "*://etsy.com/*",
        "*://*.daraz.pk/*",
        "*://daraz.pk/*",
        "*://*.daraz.com.bd/*",
        "*://daraz.com.bd/*",
        "*://*.daraz.lk/*",
        "*://daraz.lk/*",
        "*://*.daraz.com.np/*",
        "*://daraz.com.np/*",
        "*://*.daraz.ph/*",
