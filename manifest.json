        "*://*.daraz.my/*",
        "*://daraz.my/*",
        "*://*.flipkart.com/*",
        "*://flipkart.com/*",
        "*://*.noon.com/*",
        "*://noon.com/*",
        "*://*.shein.com/*",
        "*://shein.com/*",
        "*://*.target.com/*",
        "*://target.com/*",
        "*://*.costco.com/*",
        "*://costco.com/*",
        "*://*.homedepot.com/*",
        "*://homedepot.com/*",
        "*://*.bestbuy.com/*",
        "*://bestbuy.com/*",
        "*://*.lazada.com/*",
        "*://lazada.com/*",
        "*://*.lazada.sg/*",
        "*://lazada.sg/*",
        "*://*.lazada.com.my/*",
        "*://lazada.com.my/*",
        "*://*.lazada.co.th/*",
        "*://lazada.co.th/*",
        "*://*.lazada.vn/*",
        "*://lazada.vn/*",
        "*://*.lazada.com.ph/*",
        "*://lazada.com.ph/*",
        "*://*.lazada.co.id/*",
        "*://lazada.co.id/*",
        "*://*.myshopify.com/*",
        "*://myshopify.com/*",
        "*://*.worldwidegolfballs.com/*",
        "*://worldwidegolfballs.com/*",
        "*://*.worldwidegolfshops.com/*",
        "*://worldwidegolfshops.com/*",
        "*://*.worldgolfshop.com/*",
        "*://worldgolfshop.com/*",
        "*://*.golf.com/*",
        "*://golf.com/*",
        "*://*.rockbottomgolf.com/*",
        "*://rockbottomgolf.com/*"
      ],
      "js": [
        "lib/jszip.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
